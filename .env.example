# ---------------------------------------------------------------------------
# Fabrick — environment variables
# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# SvelteKit exposes any var prefixed with PUBLIC_ to the browser; everything
# else stays server-only and is read via $env/static/private.
# ---------------------------------------------------------------------------

# --- Privy (wallet substrate) ----------------------------------------------
# App ID is safe to expose to the client.
PUBLIC_PRIVY_APP_ID=
# App secret is server-only — used by the Privy Node SDK / REST API to sign
# wallet operations. Never prefix with PUBLIC_.
PRIVY_APP_SECRET=
# Webhook signing secret — set once you've added a Privy webhook destination.
# Deferred for local dev (no public URL yet); user upsert runs through the
# /api/auth/session endpoint instead. Add when you've configured a webhook
# in the Privy dashboard pointing at your deployed environment.
PRIVY_WEBHOOK_SECRET=

# --- Solana data sources ---------------------------------------------------
# Helius — onchain accounts, balances, tx history, parsed swaps (Enhanced
# Transactions), real-time tx streams (LaserStream / transactionSubscribe).
HELIUS_API_KEY=
# Jupiter — token prices via Price API V3. Free tier is generous (60 rpm)
# but a portal key unlocks higher limits. Same pricing source Phantom uses.
JUPITER_API_KEY=
# TopLedger — cross-protocol DeFi position data and PnL across 20+ Solana
# protocols (Kamino, Drift, marginfi, Jupiter perps, Raydium/Orca/Meteora LP,
# native staking, etc.). Has an MCP server at api.topledger.xyz/mcp/sse so
# agents can call its tools natively.
TOPLEDGER_API_KEY=
# Birdeye — OPTIONAL. Only needed if/when we render OHLCV candle charts or
# WebSocket real-time charts. Free tier is tight (1 rps). Skip for v0.
BIRDEYE_API_KEY=

# --- Research + agents (single LLM API surface) ----------------------------
# Exa — web research / news synthesis tool for research agents.
EXA_API_KEY=
# OpenRouter — OPTIONAL dev fallback only. Production runs BYOK: each user
# pastes their own key in Settings, which is encrypted at rest in Supabase
# (see docs/design.md §13). Setting this variable does NOT bypass BYOK at
# runtime — it's available for local dev scripts that want to short-circuit
# the Supabase decrypt path. Leave blank in deployed environments.
OPENROUTER_API_KEY=

# --- Discover route (article body scraping) --------------------------------
# Firecrawl — OPTIONAL but recommended for /discover/[slug]. Used to scrape
# the upstream article body when a user opens a story page, so the body
# render + "chat with this story" composer have real content to work with.
# Without it, /discover/[slug] falls back to the CoinDesk snippet (still
# renders the page, but chat context is shallower). Scraped bodies are
# cached in api_cache for 7 days per slug.
#
# Note (2026-05-18): we evaluated Exa's /contents endpoint as a substitute
# since EXA_API_KEY is already configured, but it failed reliability tests
# on real news sites (2/3 sites returned binary garbage or anti-scrape
# blocks; the one success had heavy unstripped page chrome). Firecrawl's
# onlyMainContent extractor is purpose-built for this and worth the
# separate env var. See firecrawl.ts header comment for the data.
FIRECRAWL_API_KEY=

# --- Persistence (Supabase) ------------------------------------------------
# Project URL is not secret (visible in any browser request). Pre-filled
# for the canonical Fabrick project; override if pointing at a fork.
PUBLIC_SUPABASE_URL=https://pmhwkgbzhplwajaxfvcj.supabase.co
# Publishable key (sb_publishable_*) — safe for client-side use, RLS is the
# real security boundary. Grab from Supabase dashboard → Project Settings →
# API → "Publishable" or via the Supabase MCP `get_publishable_keys` tool.
PUBLIC_SUPABASE_ANON_KEY=
# Secret key (`sb_secret_*`, formerly "service_role") — full backend access,
# bypasses RLS. Server-only, never expose to the client. Used by SvelteKit
# `+page.server.ts` for the Privy-webhook user upsert and for calling
# get_openrouter_key() during agent runs. Grab from Supabase dashboard →
# Project Settings → API → "Secret keys" (the MCP intentionally does not
# surface this key). Variable name kept for backwards compatibility with
# Supabase-related tooling that still expects SERVICE_ROLE.
SUPABASE_SERVICE_ROLE_KEY=
# JWT secret — Supabase's HS256 signing secret. Used to mint per-request
# Supabase JWTs from Privy sessions (Privy DID → `sub` claim → RLS via
# `current_privy_user_id()`). Server-only. Grab from Supabase dashboard →
# Project Settings → API → "JWT Settings" → "JWT Secret".
SUPABASE_JWT_SECRET=

# --- Turso (fleet-run archive layer) ---------------------------------------
# Shared multi-tenant Turso DB that holds completed fleet runs. Read by the
# /research/[ns]/[sid] load function (archive-first), written by
# /api/fleet/archive when the orchestrator's final synthesis lands. Rows are
# scoped by user_id (Privy DID) — libSQL has no Postgres-style RLS, so the
# `WHERE user_id = ?` predicate in libsql.ts is the isolation boundary.
# Grab from the Turso dashboard → your DB → "Connect" → URL + auth token.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# --- Coral Protocol --------------------------------------------------------
# Local default; production points to a hosted Coral server.
CORAL_SERVER_URL=http://localhost:5555
# Must match coral-server's `auth.keys` in config.toml. Default local key is "local".
CORAL_AUTH_TOKEN=local
# Where Fabrick's hosted MCP servers (/mcp/jupiter, /mcp/defillama) are
# reachable from agent processes spawned by Coral. Defaults to the local
# SvelteKit dev server. Use `127.0.0.1` instead of `localhost` so the JVM
# doesn't resolve to IPv6 (`::1`), which vite doesn't bind by default.
FABRICK_MCP_BASE_URL=http://127.0.0.1:5173

# --- Fleet gateway ---------------------------------------------------------
# The browser connects to the fleet-gateway for live fleet event streams —
# NOT directly to coral-server (which would leak CORAL_AUTH_TOKEN to every
# client and require Coral to be public). Run the gateway locally with
# `cd services/fleet-gateway && bun run dev`. See services/fleet-gateway/.
# Base URL the browser reaches the gateway at (http/https → ws/wss).
FLEET_GATEWAY_URL=http://localhost:8787
# HMAC secret the app uses to mint session-scoped JWTs the gateway verifies.
# MUST match the gateway process's GATEWAY_JWT_SECRET exactly.
GATEWAY_JWT_SECRET=dev-gateway-secret-change-me
# Shared secret authenticating the gateway's server-side archive callback to
# /api/fleet/archive (so a run archives even if the browser tab closed). MUST
# match the gateway process's GATEWAY_SERVICE_SECRET. Leave blank to disable
# the server-side trigger (client still archives).
GATEWAY_SERVICE_SECRET=dev-gateway-service-secret-change-me

# ---------------------------------------------------------------------------
# Dev-only auth bypass (NEVER set in production — it's also hard-gated to
# `vite dev` in hooks.server.ts, so a prod build ignores it regardless).
# Lets Playwright / local browsing reach gated routes without the Privy
# login flow by impersonating a REAL users row.
#   <privy-did>  → impersonate that specific user
#   *            → grab the first users row (zero-config, fine for solo dev)
# Leave unset/blank to keep auth fully enforced locally.
# DEV_AUTH_PRIVY_DID=*
