# fleet-gateway config — all via env so dev and prod differ only in values.

# Port the gateway listens on (browser connects here).
PORT=8787

# coral-server base URL. The gateway holds this + the token; the browser
# never sees either. Private network in production.
CORAL_SERVER_URL=http://localhost:5555

# Shared coral-server auth token. Lives ONLY here, never reaches the client.
# Must match an entry in coral-server's auth.keys.
CORAL_AUTH_TOKEN=local

# HMAC secret shared with the SvelteKit app. The app mints session-scoped
# JWTs with it; the gateway verifies them. MUST match the app's
# GATEWAY_JWT_SECRET exactly.
GATEWAY_JWT_SECRET=dev-gateway-secret-change-me

# --- Server-side archive (optional) ----------------------------------------
# When set, the gateway fires the archive on synthesis — even if the browser
# tab closed — by calling back into the SvelteKit app. Leave blank to disable
# (the client still archives).
# Base URL of the SvelteKit app the gateway calls back to.
APP_BASE_URL=http://localhost:5173
# Shared secret for that callback. MUST match the app's GATEWAY_SERVICE_SECRET.
GATEWAY_SERVICE_SECRET=dev-gateway-service-secret-change-me
