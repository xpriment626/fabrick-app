{
	"name": "fabrick",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=20.19.0"
	},
	"scripts": {
		"dev": "vite dev",
		"dev:auth": "tsx scripts/dev-savings.ts",
		"dev:bypass": "tsx scripts/dev-savings.ts --bypass",
		"dev:savings": "tsx scripts/dev-savings.ts",
		"dev:savings:bypass": "tsx scripts/dev-savings.ts --bypass",
		"smoke:coral:savings": "tsx scripts/coral-savings-smoke.ts",
		"test": "tsx --test $(find src scripts -name '*.test.ts' -print)",
		"test:e2e": "playwright test",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
	},
	"devDependencies": {
		"@playwright/test": "^1.60.0",
		"@sveltejs/adapter-vercel": "^5.4.0",
		"@sveltejs/kit": "^2.20.0",
		"@sveltejs/vite-plugin-svelte": "^5.0.0",
		"@tailwindcss/vite": "^4.0.0",
		"@types/node": "^22.0.0",
		"@types/qrcode": "^1.5.6",
		"@types/ws": "^8.18.1",
		"svelte": "^5.0.0",
		"svelte-check": "^4.0.0",
		"tailwindcss": "^4.0.0",
		"tslib": "^2.6.0",
		"tsx": "^4.22.0",
		"typescript": "^5.5.0",
		"vite": "^6.0.0"
	},
	"dependencies": {
		"@fontsource-variable/inter": "^5.0.0",
		"@kamino-finance/farms-sdk": "3.2.24",
		"@kamino-finance/klend-sdk": "^8.0.2",
		"@privy-io/js-sdk-core": "^0.63.0",
		"@privy-io/server-auth": "^1.32.5",
		"@supabase/supabase-js": "^2.105.3",
		"jose": "^6.2.3",
		"qrcode": "^1.5.4",
		"ws": "^8.20.1",
		"zod": "^4.4.3"
	}
}
